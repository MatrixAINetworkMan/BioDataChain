# =============================================================================
# 交易所自建节点 .env 模板
#   cp .env.example .env && vim .env  # 填好后 docker compose -f docker-compose.exchange.yml up -d
#
# 标注「项目方提供」的项由 Matrix 项目方在交付时填好或提供。
# =============================================================================

# ── 链标识 ─────────────────────────────────────────────
L2_CHAIN_ID=1200

# ── 写路径：交易转发端点（项目方提供）──────────────
# ⚠️ 节点为验证模式（不出块），发交易必须经此端点提交上链。
#    该端点由项目方提供，只接受已签名交易转发。
# 示例：http://<转发端点IP>:9561
L2_SEQUENCER_HTTP=http://<转发端点IP>:9561

# ── L1 连接（项目方提供）────────────────────────────
# L1 结算链 RPC 地址；节点靠它同步（必需）
L1_PROXY_UPSTREAM=http://<L1_IP>:8545

# ── L2 P2P（项目方提供，可选）────────────────────────
# 填了可低延迟接收新区块；留空则靠 L1 同步，延迟略高
L2_SEQUENCER_ENODE=/ip4/<SEQ_IP>/tcp/9222/p2p/16Uiu2HAm...

# ── 监听地址 ───────────────────────────────────────────
# 交易所节点对外 RPC 域名由交易所自己设置（如 rpc.exchange.com），
# 此处是节点本机监听地址。默认只绑本机；要对外提供服务需绑 0.0.0.0
# 并在交易所侧用 nginx 反代 / 安全组控制访问。
BIND_HOST=127.0.0.1
L2_RPC_PORT=9545      # op-geth JSON-RPC（读 + 写转发入口）
L2_WS_PORT=9546       # op-geth WebSocket
OP_NODE_RPC_PORT=9547 # op-node RPC（optimism_syncStatus 等）

# ── 存储模式 ───────────────────────────────────────────
# full+path：省盘，推荐（不支持历史交易内部执行细节查询）
# archive+hash：全历史 state，盘占用高数倍
OP_GETH_GCMODE=full
OP_GETH_STATE_SCHEME=path
OP_GETH_CACHE_MB=8192

# ── 镜像（项目方指定，勿自行更换版本）────────────────
# 跨版本可能存在共识差异，版本必须与项目方一致
OP_GETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-geth:v1.101702.1
OP_NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.16.12
