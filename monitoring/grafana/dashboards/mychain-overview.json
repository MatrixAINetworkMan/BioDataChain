        {
          "expr": "op_node_default_refs_number{layer=\"l1\",type=\"l1_head\"}",
          "legendFormat": "L1 Head"
        }
      ]
    },
    {
      "title": "Block Height Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "op_node_default_refs_number{layer=\"l2\",type=\"l2_unsafe\"}",
          "legendFormat": "Unsafe"
        },
        {
          "expr": "op_node_default_refs_number{layer=\"l2\",type=\"l2_safe\"}",
          "legendFormat": "Safe"
        },
        {
          "expr": "op_node_default_refs_number{layer=\"l2\",type=\"l2_finalized\"}",
          "legendFormat": "Finalized"
        }
