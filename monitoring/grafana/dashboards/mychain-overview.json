    {
      "title": "Safe-Unsafe Lag",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "op_node_default_refs_number{layer=\"l2\",type=\"l2_unsafe\"} - op_node_default_refs_number{layer=\"l2\",type=\"l2_safe\"}",
          "legendFormat": "Lag (blocks)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
