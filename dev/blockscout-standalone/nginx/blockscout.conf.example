# =============================================================================
# nginx 反代配置 —— 独立 Blockscout 机器
# 域名示例：scan.example.com（请改成你的真实域名）
#
# 部署：
#   sudo cp nginx/blockscout.conf.example /etc/nginx/conf.d/scan.example.com.conf
#   # 把 server_name / ssl 证书路径改对
#   sudo nginx -t && sudo systemctl reload nginx
#
# 本机端口（来自 .env，默认值）：
#   4000 frontend (Next.js)
#   4001 backend  (REST/GraphQL + Phoenix WS)
#   4002 stats     (首页图表)
# 注意：这台机器「只有浏览器」，没有 /rpc /ws —— 那些在链机器上。
#
# !!! 前提：/etc/nginx/nginx.conf 的 http {} 段必须有这个 map，否则 WS 升级失败：
#   map $http_upgrade $connection_upgrade { default upgrade; '' close; }
# =============================================================================

server {
    listen 80;
    server_name scan.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name scan.example.com;

    ssl_certificate     ssl/example.com.pem;
    ssl_certificate_key ssl/example.com.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 50m;
    proxy_http_version  1.1;
    proxy_read_timeout  120s;
    proxy_send_timeout  120s;

    # backend REST API + Phoenix WebSocket + sitemap + auth
    location ~ ^/(api|socket|sitemap\.xml|auth/auth0|auth/auth0/callback|auth/logout) {
        proxy_pass http://127.0.0.1:4001;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 60s;
        proxy_send_timeout   300s;
        proxy_read_timeout   300s;
    }

    # stats 微服务（末尾 / 用来 strip /stats-api 前缀）
    location /stats-api/ {
        proxy_pass http://127.0.0.1:4002/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass_request_headers on;
    }

    # frontend（兜底）
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }
}
