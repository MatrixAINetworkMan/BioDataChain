# =============================================================================
# Blockscout 独立机器部署 —— 配置文件
#
# 用法：
#   cp .env.example .env
#   然后把下面带 “← 必填” 的项改成你的真实值，再跑 ./install.sh
#
# 这套部署「只跑区块浏览器」，链（op-geth / op-node / op-batcher / L1）在别的机器。
# 本机通过网络访问那些机器的 RPC 来索引数据。
# =============================================================================

# -----------------------------------------------------------------------------
# 1) 对外域名 / 访问方式
# -----------------------------------------------------------------------------
# 浏览器最终通过哪个 URL 访问这台机器上的 Blockscout（nginx 前置 + HTTPS）。
# 例：https://scan.example.com   （需要你把这个域名 DNS 解析到本机公网 IP）
# 留空 = 直连模式：浏览器走 http://<本机IP>:4000（仅调试用，钱包加链会因非 HTTPS 失败）
BLOCKSCOUT_PUBLIC_URL=https://scan.example.com

# 直连模式 / 拼 URL 兜底用的本机 IP（反代模式下可不填）
PUBLIC_HOST=127.0.0.1

# stats 微服务对外入口（首页图表数据源）。推荐走主域名子路径反代：
#   https://scan.example.com/stats-api
# nginx 配置见 nginx/blockscout.conf.example
BLOCKSCOUT_STATS_PUBLIC_URL=https://scan.example.com/stats-api

# -----------------------------------------------------------------------------
# 2) 本机容器对外暴露的端口（nginx 反代到这些端口；不直接对公网开）
# -----------------------------------------------------------------------------
BLOCKSCOUT_PORT=4000          # frontend (Next.js)
BLOCKSCOUT_API_PORT=4001      # backend (Elixir API/indexer)
BLOCKSCOUT_STATS_PORT=4002    # stats 微服务

# -----------------------------------------------------------------------------
# 3) L2 链 RPC —— indexer 用来索引数据（指向「链那台机器」的 op-geth）   ← 必填
#
# 三个都要能从本机访问。两种接法二选一：
#   A) 私网直连（推荐，快）：  http://<op-geth机器内网IP>:9545 / ws://...:9546
#   B) 走公网 HTTPS 反代：     https://dev.example.com/rpc （WS 需对端 nginx 配 /ws）
#
# 注意：
#   - TRACE 必须支持 debug_ 命名空间（op-geth 已开 --http.api=...,debug,...）
#   - WS 是实时索引必需；公网模式需要对端 nginx 暴露 wss
# -----------------------------------------------------------------------------
L2_RPC_HTTP=http://REPLACE_ME_OPGETH_IP:9545
L2_RPC_WS=ws://REPLACE_ME_OPGETH_IP:9546
L2_RPC_TRACE=http://REPLACE_ME_OPGETH_IP:9545

# 钱包「Add network」里展示给用户的公网 RPC（必须 HTTPS，给终端用户用）
# 一般指向链机器的公网 RPC，不是上面的私网地址
L2_RPC_PUBLIC_URL=https://dev.example.com/rpc

# -----------------------------------------------------------------------------
# 4) L1 链 RPC —— optimism 跨链索引（deposit/withdrawal/batch）用    ← 必填
# 指向「L1 那台机器」的 geth。可走私网 IP:8545 或公网 https://devl1.example.com/rpc
# -----------------------------------------------------------------------------
L1_RPC=http://REPLACE_ME_L1_IP:8545

# L1 出块间隔（秒），跟 L1 链实际一致（Clique PoA 一般 2 或 3）
L1_BLOCK_TIME=2

# -----------------------------------------------------------------------------
# 5) 链元信息                                                          ← 必填核对
# -----------------------------------------------------------------------------
L2_CHAIN_ID=175188                  # 0x2ae54，跟 op-geth eth_chainId 一致
NATIVE_TOKEN_SYMBOL=MAN
NATIVE_TOKEN_NAME=MAN

# -----------------------------------------------------------------------------
# 6) Optimism L1 合约地址（来自链机器的 workdir/shared/l1-addresses.env）  ← 必填
# 在链机器上执行：cat workdir/shared/l1-addresses.env  把对应值抄过来
# -----------------------------------------------------------------------------
OPTIMISM_PORTAL_PROXY=0xREPLACE_ME
SYSTEM_CONFIG_PROXY=0xREPLACE_ME
DISPUTE_GAME_FACTORY_PROXY=0xREPLACE_ME
BATCHER_ADDRESS=0xREPLACE_ME
# batch inbox 地址（链机器 rollup.json 里的 .batch_inbox_address）
BATCH_INBOX_ADDRESS=0xREPLACE_ME
# L2 batch 起始块（一般 0）
INDEXER_OPTIMISM_L2_BATCH_GENESIS_BLOCK_NUMBER=0

# -----------------------------------------------------------------------------
# 7) Blockscout 安全密钥（>=64 字符）
# 留空则 install.sh 自动生成并写回 .env
# -----------------------------------------------------------------------------
BLOCKSCOUT_SECRET_KEY_BASE=

# -----------------------------------------------------------------------------
# 8) 镜像版本（升级方法见 README「升级 Blockscout」）
#
# ⚠️⚠️ 后端 optimism flavor 必须自己编译！⚠️⚠️
#   Blockscout 自 v10 起不再发布公开的 optimism 镜像：
#     - 公开仓库 ghcr.io/blockscout/blockscout-optimism 永久停在 9.0.2（已验证 10/11 全 404）
#     - v10/v11 只推到私有仓库 blockscout-optimism-private（外部拉不了）
#     - optimism 是「编译期」chain type，通用 blockscout 镜像不能索引 OP deposit/withdrawal/batch
#   因此后端要 v11 必须从源码编译（见 README「升级 Blockscout / 自编译 optimism 后端」）：
#     git clone --branch v11.2.0 https://github.com/blockscout/blockscout
#     docker build -f docker/Dockerfile \
#       --build-arg CHAIN_TYPE=optimism --build-arg RELEASE_VERSION=11.2.0 \
#       --build-arg BLOCKSCOUT_VERSION=v11.2.0 -t blockscout-optimism:11.2.0-local .
#   然后把 BLOCKSCOUT_BACKEND_IMAGE 指向本地 tag（多机/HA 则推到自有 registry 再引用）。
#
# ⚠️⚠️ 前端新版同样要自己编译！⚠️⚠️
#   和后端一个套路：公开 docker 仓库 ghcr.io/blockscout/frontend 永久停在 v2.3.5（8个月前），
#   :latest 也指向 v2.3.5；v2.7/v2.8 的源码 release 有，但镜像只推私有仓库 frontend-private。
#   v2.3.5 配 v11 后端能跑但偏旧（OP 新页面可能显示不全）；v2.7.0 起官方才声明仅兼容 API ≥ v10。
#   要前端 v2.8.0（与后端 v11 最佳兼容）必须从源码编译（见 README「自编译前端」）：
#     git clone --branch v2.8.0 --depth 1 https://github.com/blockscout/frontend frontend-src
#     docker build -f Dockerfile --build-arg GIT_TAG=v2.8.0 -t blockscout-frontend:2.8.0-local .
#   ⚠️ 构建峰值要 ~8GB 内存（Dockerfile 写死 --max-old-space-size=8192），内存小先加 swap。
#
# 当前版本：后端 optimism v11.2.0（自编译）/ 前端 v2.8.0（自编译）
#           stats 必须 ≥ v2.16.0（后端 v11 删了 internal_transactions 部分列，旧 stats 首页图表会坏），:latest 满足；
#           verifier / sig-provider 是 flavor 无关的公开镜像，API 稳定，与后端大版本无强绑定。
# ⚠️ stats/verifier/sig 生产建议钉死 digest 防 :latest 漂移：docker pull <tag> 后用
#    docker inspect --format '{{index .RepoDigests 0}}' <tag> 取 digest 回填这里。
# -----------------------------------------------------------------------------
BLOCKSCOUT_BACKEND_IMAGE=blockscout-optimism:11.2.0-local
BLOCKSCOUT_FRONTEND_IMAGE=blockscout-frontend:2.8.0-local
BLOCKSCOUT_STATS_IMAGE=ghcr.io/blockscout/stats:latest
BLOCKSCOUT_VERIFIER_IMAGE=ghcr.io/blockscout/smart-contract-verifier:latest
BLOCKSCOUT_SIG_PROVIDER_IMAGE=ghcr.io/blockscout/sig-provider:latest
