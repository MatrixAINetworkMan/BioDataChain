# =============================================================================
# MyChain L1 — 独立自建 L1 dev/staging 链（geth Clique PoA, 单 validator）
#
# 用法：
#   cp .env.example .env
#   编辑下面的 PUBLIC_HOST 和 VALIDATOR_PASSWORD，其余可保持默认
#   make init  # 一次性：生成 validator + 渲染 genesis + geth init
#   make up    # 启动 L1
#   make status
# =============================================================================

# -----------------------------------------------------------------------------
# 服务器外网 IP / 域名（团队从外面 RPC 接入用，文档/info 输出会用到，
# 不参与 chain 配置）
# -----------------------------------------------------------------------------
PUBLIC_HOST=

# -----------------------------------------------------------------------------
# Chain identity
# -----------------------------------------------------------------------------
# L1 chain id。保持 901 与 dev anvil 一致，未来 L2 接入时不用改 op-deployer 配置。
# 想完全独立（避免跟 anvil dev 链共享 901）可以换成例如 9011。
L1_CHAIN_ID=901

# L1 出块周期（秒）。Clique 是固定周期出块，即使没 tx 也出空块。
# 2 秒 = 跟 mainnet PoS slot 一致；要更快可改 1（最小值）。
L1_BLOCK_TIME=2

# 单块 gas limit。30M 是以太坊 mainnet 同值，部署 OP Stack 合约和
# op-batcher 提交 calldata 都够用。
L1_GAS_LIMIT=30000000

# 链显示名（浏览器各处会用到）
#   L1_NETWORK_NAME       = full name，浏览器 header / tab title / backend SUBNETWORK
#   L1_NETWORK_SHORT_NAME = short name，钱包小图标旁的标签 / backend NETWORK
# 跟 L2 区分：L2 叫 "MAN Dev" / "MAN"，L1 加上 L1 后缀
#
# ⚠️ 值含空格必须加双引号！否则 scripts/blockscout-up.sh 的 `source .env` 会把
# 空格后的部分当命令执行，整个 .env 加载失败 → 所有 docker-compose 端口替换缺值
# → 报 "invalid hostPort"。
L1_NETWORK_NAME="MAN L1 Dev"
L1_NETWORK_SHORT_NAME="MAN L1"

# -----------------------------------------------------------------------------
# Geth 镜像（v1.13.15 是最后一个 shanghai+cancun+Clique 全支持的稳定版；
# v1.14.x Clique 还能用但被标 deprecated；v1.15 彻底删除 Clique。
# 想升 v1.14.x 需要自测 unlock / clique RPC 兼容性。）
# -----------------------------------------------------------------------------
GETH_IMAGE=ethereum/client-go:v1.13.15

# -----------------------------------------------------------------------------
# Validator keystore 密码（只用于解锁本地 keystore，不上链）
# 生产请务必修改并保密
# -----------------------------------------------------------------------------
VALIDATOR_PASSWORD=changeme-in-prod

# Validator 地址（由 make init 自动生成并写回此变量，初始留空）
VALIDATOR_ADDRESS=

# 可选：给 dev 钱包预存 L1 ETH（逗号/空格分隔的 0x 地址列表）。
# 留空 = 只有 validator 有余额；填了 make init 会给每个地址塞 10000 ETH。
# 仅 dev 用，生产请保持为空（资金通过桥接获取）。不要入仓真实地址。
# 例：DEV_FUND_ADDRESSES=0xYourDevWallet1,0xYourDevWallet2
DEV_FUND_ADDRESSES=

# -----------------------------------------------------------------------------
# 端口绑定策略（最重要的安全开关）
#
# BIND_HOST 控制 docker 把端口暴露到 host 的哪个网卡：
#   127.0.0.1 (默认，推荐) ：只本机可访问，外部访问全部经 nginx + HTTPS 反代
#                          → 公网防火墙只需开 22 / 80 / 443
#   0.0.0.0              ：直接暴露公网（运维必须开 8545/8546/3001/4001/8081）
#                          → 仅 dev 阶段方便 MetaMask / Foundry 直连时用
# -----------------------------------------------------------------------------
BIND_HOST=127.0.0.1

# 端口（host 上对外暴露）
HTTP_PORT=8545
WS_PORT=8546
P2P_PORT=30303

# =============================================================================
# Blockscout（L1 区块浏览器）— 可选模块
# 不用浏览器可不设；用浏览器只需配 BS_PORT/API_PORT/STATS_PORT 三个端口
# 想绑域名走 HTTPS，把 BS_PUBLIC_URL 设成 https://l1.example.com 即可
# 启动：make blockscout-up    停止：make blockscout-down
# =============================================================================
BS_PORT=3001              # frontend HTTP（浏览器访问的主入口）
BS_API_PORT=4001          # backend HTTP/WS API（浏览器 ajax + Phoenix WS）
BS_STATS_PORT=8081        # stats 微服务（首页 Daily transactions）

# 反代/HTTPS 模式：留空 = 直连 (http://PUBLIC_HOST:BS_PORT)
# 设了就走该域名，nginx/caddy 反代到 BS_PORT/BS_API_PORT/BS_STATS_PORT
#
# 当前生产域名（已申请）：
BS_PUBLIC_URL=https://devl1.example.com
# stats 默认跟主域同站走 /stats-api/ 子路径，单独子域名才需要这里另外设
BS_STATS_PUBLIC_URL=

# Blockscout secret key base（必须 ≥ 64 字符；生产请改）
BS_SECRET_KEY_BASE=mychain-l1-dev-please-change-in-prod-this-is-a-long-fixed-secret-string-for-testing-only

# Blockscout 镜像（默认全部 latest）
BS_BACKEND_IMAGE=ghcr.io/blockscout/blockscout:latest
BS_FRONTEND_IMAGE=ghcr.io/blockscout/frontend:latest
BS_VERIFIER_IMAGE=ghcr.io/blockscout/smart-contract-verifier:latest
BS_STATS_IMAGE=ghcr.io/blockscout/stats:latest
