# =============================================================================
# .env.flashblocks — mychain v7 (Flashblocks) 覆盖配置
#
# 用法：跟 .env 一起 source，由 make flashblocks-up / make dev-up-flashblocks
#       自动加载（dev/scripts/flashblocks-up.sh 用 --env-file 串联）。
#
# 设计原则：
#   - 只列出 v7 跟 v6 不同的变量，其他全部继承 .env
#   - 改 chainId 是关键变化（避免 MetaMask 缓存炸）
#   - image tag 要求显式：因 flashbots 的 op-rbuilder/rollup-boost/flashblocks-rpc
#     版本变化频繁，不锁版本会让本地复现失败
#   - 详见 docs/PHASE2_INTEGRATION.md §3, §4
# =============================================================================

# ============= L2 chainId =============
# v6=42170 → v7=175700。chainlist.org 实测未注册（2026-05-09 查）。
# 这个一改，op-deployer/op-geth-init/op-geth 三个一次性容器都得重跑，
# fresh chain；旧 v6 state 不兼容。
L2_CHAIN_ID=175700
# 175700 dec = 0x2ae54 — 64-char 0-padded hex 给 op-deployer / intent.toml id 字段用
L2_CHAIN_ID_HEX=0x000000000000000000000000000000000000000000000000000000000002ae54

# ============= op-node 改指 rollup-boost =============
# 让 op-node 的 Engine API 不打到 op-geth:8551 而是 rollup-boost:8081，
# 让 boost 做 dispatch（同时打 op-geth + op-rbuilder）。
# 注意端口：rollup-boost 的 --rpc-port 默认是 8081（不是 op-geth 那个 8551），
# 这是它接 op-node engine API 的端口（详见 https://github.com/flashbots/rollup-boost README）。
OP_NODE_L2_ENGINE_URL=http://rollup-boost:8081

# ============= 4 个新增容器的 image =============
# 这些 tag 在 chain-test2 上首次拉时务必显式 pin。Flashbots 的镜像更新极快，
# `:latest` 在两次 pull 之间可能行为不一致（导致复现失败）。
# 推荐填一个 sha256 digest 或具体 release tag。
#
# 参考 release：
#   op-rbuilder:        https://github.com/flashbots/op-rbuilder/releases
#   rollup-boost:       https://github.com/flashbots/rollup-boost/releases
#   flashblocks-rpc:    见 op-rbuilder 仓库 / 或独立 image
#
# 2026-05-11 实测可拉的 tag 组合（已 verify GHCR/DockerHub 上真实存在）：
#   - op-rbuilder    : sha-e5e6711  (ghcr.io 上 "Latest" 实际是 git-sha 标签，没有 semver；
#                                    最新 release v0.3.1 没推到 ghcr，0.3.1/0.3.0 等 tag 全是 404)
#   - rollup-boost   : nightly      (ghcr 的 "Latest" 标签实际叫 nightly，不是 latest)
#   - flashblocks-rpc: sha-7caffb9  (Docker Hub，不是 ghcr.io！10 个月前发的最后版本，v7.0 不启)
#
# 升级时去 GHCR pkgs 页查最新 git-sha：
#   https://github.com/flashbots/op-rbuilder/pkgs/container/op-rbuilder
#   https://github.com/flashbots/rollup-boost/pkgs/container/rollup-boost
OP_RBUILDER_IMAGE=ghcr.io/flashbots/op-rbuilder:sha-e5e6711
ROLLUP_BOOST_IMAGE=ghcr.io/flashbots/rollup-boost:nightly
FLASHBLOCKS_RPC_IMAGE=flashbots/flashblocks-rpc:sha-7caffb9

# ============= 4 个新增容器的命令行参数 =============
# docker-compose.flashblocks.yml 里给了"实测可行的默认 args"，但保留这个变量
# 让你在服务器上调整不用改 yaml（提速版本兼容工作）。
#
# 真要覆盖的话像这样：
#   OP_RBUILDER_ARGS=node --chain=/shared/genesis.json --datadir=/data/rbuilder ...
#
# 默认值已在 docker-compose.flashblocks.yml 里，留空让它用默认。
# OP_RBUILDER_ARGS=
# ROLLUP_BOOST_ARGS=
# FLASHBLOCKS_RPC_ARGS=

# ============= 端口（host 暴露）=============
OP_RBUILDER_PORT=9550
OP_RBUILDER_WS_PORT=9551
ROLLUP_BOOST_PORT=9555
FLASHBLOCKS_RPC_PORT=9548
BUNDLE_PROXY_PORT=9560
BUNDLE_PROXY_METRICS_PORT=9561

# ============= bundle-proxy 行为 =============
# in-flight 上限：单实例并发写请求超过这个数直接返 -32000。
# 默认 1000 是 Phase 1.5 实测推荐值（800 TPS 稳态 + 1.25x 余量）。
# chain-test2 实测要拉 Grafana 看 saturation 调整。
BUNDLE_PROXY_IN_FLIGHT_LIMIT=1000

# bundle.blockNumber = head + N。10 给 10s 的 builder 打包窗口，
# 防止高 TPS 下因 RPC 排队而 bundle 已过期被 silent drop（Phase 1.6 实测）。
BUNDLE_PROXY_BLOCK_OFS=10

# undici 连接池
BUNDLE_PROXY_POOL_SIZE=32
BUNDLE_PROXY_PIPELINE=10
BUNDLE_PROXY_TIMEOUT_MS=5000

# 读路径默认走 op-geth（finalized 稳）。
# v7.0 阶段 flashblocks-rpc 独立 image 已废弃（见 docker-compose.flashblocks.yml 注释），
# 想试 pre-confirmation 视图请：
#   1. docker compose --profile flashblocks-rpc up flashblocks-rpc
#   2. 把这里改成 flashblocks
# v7.1 计划：base/node-reth 风格 reth fork 替代独立 flashblocks-rpc 容器
BUNDLE_PROXY_READ_TARGET=opgeth

# flashblocks-rpc 服务 URL（开 profile 才用得到，默认 read_target=opgeth 时这条无效）
BUNDLE_PROXY_FLASHBLOCKS_URL=http://flashblocks-rpc:8545

# 是否启用 fallback（rbuilder 失败时走 op-geth raw tx）
BUNDLE_PROXY_FALLBACK=true
BUNDLE_PROXY_FALLBACK_THRESHOLD=5
BUNDLE_PROXY_FALLBACK_HALF_OPEN_MS=5000

# 日志级别（dev 用 info，压测时改 warn 防日志爆）
BUNDLE_PROXY_LOG_LEVEL=info

# ============= 压测流量 RPC 路径（tokenspammer/flashblocks-spammer 用）=============
# v6 下 tokenspammer 直连 op-geth；v7 下 dApp 唯一入口是 bundle-proxy:9560，
# 压测流量也走这里才能验证 fail-fast / 适配 / 熔断真实表现。
#
# 容器内地址（docker network mychain-dev 里解析），跟 Makefile 顶部
# 三个 L2_RPC_URL_INTERNAL/SPAM_RPC_URL_INTERNAL/DIAG_RPC_URL_INTERNAL 对齐：
#   - L2_RPC_URL_INTERNAL : 链 metadata / 合约部署 / token mint 走 op-rbuilder（sequencer）
#     ⚠️ v7.1 改动：原本走 op-geth，但 op-geth 在 Flashblocks 拓扑里只是 follower，
#         deploy/mint/fund 的 tx 进 op-geth mempool 永远不被 op-rbuilder 打包 →
#         同 nonce 重发触发 "replacement transaction underpriced"。bot 部署阶段必须
#         直连 sequencer（op-rbuilder）才能让 tx 真正上链。
#   - SPAM_RPC_URL_INTERNAL: 压测 send 走 bundle-proxy（v7 dApp 入口，验证 fail-fast / 熔断 / fallback）
#   - DIAG_RPC_URL_INTERNAL: mempool / chain-tps 监控走 op-rbuilder（看 builder 内部）
L2_RPC_URL_INTERNAL=http://op-rbuilder:8545
SPAM_RPC_URL_INTERNAL=http://bundle-proxy:9560
DIAG_RPC_URL_INTERNAL=http://op-rbuilder:8545

# ============= Blockscout indexer 指向 =============
# v7.0 阶段：Blockscout 全部指 op-geth（finalized，稳）。
# 原计划 D3=force_d3b 指 flashblocks-rpc 因独立 image 已废弃暂时回退到 op-geth。
# v7.1 计划：base/node-reth 替代后再切到 pre-confirmation。
# Reorg 风险讨论见 docs/PHASE2_INTEGRATION.md §6。
BLOCKSCOUT_INDEXER_RPC=http://op-geth:8545
BLOCKSCOUT_INDEXER_TRACE_RPC=http://op-geth:8545
BLOCKSCOUT_INDEXER_WS=ws://op-geth:8546
