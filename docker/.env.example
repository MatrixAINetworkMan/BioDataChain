# =============================================================================
# Docker Compose Environment Variables
# Copy to .env and fill in all values before running docker compose
# =============================================================================

# L1 (BSC) Connection
L1_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
L1_RPC_KIND=standard

# Chain Configuration
L2_CHAIN_ID=42170

# Wallet Keys
GS_SEQUENCER_ADDRESS=
GS_SEQUENCER_PRIVATE_KEY=
GS_BATCHER_PRIVATE_KEY=
GS_PROPOSER_PRIVATE_KEY=

# L1 Contract Addresses (from deployment output)
L2_OUTPUT_ORACLE_PROXY=

# Port Mapping (change if conflicts with host)
OPGETH_HTTP_PORT=8545
OPGETH_WS_PORT=8546
OPNODE_RPC_PORT=8547
OPBATCHER_RPC_PORT=8548
OPPROPOSER_RPC_PORT=8560

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=mychain2024
